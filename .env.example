SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_API_KEY=
SOCLAAS_MODEL=default

# HTTPS deployments must set this to true. Leave false only on local HTTP.
COOKIE_SECURE=false
# Local OCR is opt-in; no external OCR upload is performed.
OCR_ENABLED=false
OCR_LANGUAGE=eng+chi_sim
# Optional absolute executable paths when tools are not on PATH:
# TESSERACT_PATH=/path/to/tesseract
# PDFTOPPM_PATH=/path/to/pdftoppm
